<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Add Student</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="form-page">
    <div class="form-container">
      <h1>Create New Student</h1>
      <p class="form-description">Enter student details below</p>

      <form class="student-form" method="post" action="/student">
        <div class="form-group">
          <label>Name</label>

          <input
            class="form-input"
            type="text"
            name="name"
            placeholder="Enter student name"
            required
          />
        </div>

        <div class="form-group">
          <label>Roll Number</label>

          <input
            class="form-input"
            type="text"
            name="rollNo"
            placeholder="Enter roll number"
            required
          />
        </div>

        <div class="form-group">
          <label>Branch</label>

          <input
            class="form-input"
            type="text"
            name="branch"
            placeholder="Enter branch"
            required
          />
        </div>

        <div class="form-group">
          <label>Semester</label>

          <input
            class="form-input"
            type="number"
            name="semester"
            placeholder="Enter semester"
            required
          />
        </div>

        <div class="form-group">
          <label>Email</label>

          <input
            class="form-input"
            type="email"
            name="email"
            placeholder="Enter email"
          />
        </div>

        <div class="form-group">
          <label>Phone</label>

          <input
            class="form-input"
            type="tel"
            name="phone"
            placeholder="Enter phone number"
          />
        </div>

        <div class="form-group">
          <label>Gender</label>

          <select class="form-input" name="gender">
            <option value="">Select gender</option>

            <option value="male">Male</option>

            <option value="female">Female</option>

            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label>Address</label>

          <textarea
            class="form-input textarea"
            name="address"
            placeholder="Enter address"
            rows="3"
          ></textarea>
        </div>

        <div class="form-buttons">
          <a href="/student" class="btn back-btn"> Back </a>

          <button type="submit" class="btn submit-btn">Create Student</button>
        </div>
      </form>
    </div>
  </body>
</html>
